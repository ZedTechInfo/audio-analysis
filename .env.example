HF_TOKEN=your_huggingface_token_here
AUTOACE_ENVIRONMENT=production
AUTOACE_API_KEY=replace_with_a_long_random_api_key
AUTOACE_REQUIRE_API_KEY=true
AUTOACE_ALLOW_SIGNUP=false
AUTOACE_INFERENCE_ENGINE=baseline
AUTOACE_SER_MODEL_ID=superb/wav2vec2-base-superb-er
AUTOACE_SER_WINDOW_SECONDS=8
AUTOACE_SER_HOP_SECONDS=4
AUTOACE_WORKER_COUNT=1
AUTOACE_MAX_UPLOAD_BYTES=104857600
AUTOACE_MAX_UNCOMPRESSED_BYTES=524288000
AUTOACE_MAX_FILES=500
AUTOACE_MAX_AUDIO_SECONDS=3600
